      .hero-thumbs { width:100%; }
      .hero-thumb { flex:1; min-width:0; width:auto; }
      .taller-media, .taller-media img { min-height:320px; }
      .cta-panel { min-height:400px; }
      .footer-grid { padding-left:clamp(24px,6vw,40px); gap:32px 24px; }
      .footer-stripe { left:0; border-radius:28px; }
      .footer-wordmark { padding-left:clamp(24px,6vw,40px); justify-content:flex-start; }
      .footer-wordmark span { font-size:16vw; }
    }
    @media (min-width: 861px) { .mobile-menu { display:none; } }

    @media (max-width: 480px) {
      .footer-wordmark span { font-size:13vw; }
      .header { padding:12px 14px 12px 18px; }
      .thumb-img-wrap { height:56px; }
    }
  </style>
</head>
<body>
<div class="wrap">

