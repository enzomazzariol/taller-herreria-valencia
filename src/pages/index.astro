    .faq-list summary:hover { color:var(--fl-accent); }
    .faq-list p { margin:14px 0 0; font-size:16px; line-height:1.75; color:var(--fl-body); max-width:620px; opacity:0; transition:opacity .22s ease; }
    .faq-list details[open] p { opacity:1; }

    .cta-sec { padding:0 clamp(16px,3vw,48px) clamp(20px,2.4vw,32px); }
    .cta-panel { position:relative; overflow:hidden; max-width:1240px; margin:0 auto; border-radius:var(--fl-r) clamp(60px,12vw,180px) var(--fl-r) var(--fl-r); background:#1B1814; min-height:520px; display:flex; align-items:center; }
    .cta-panel img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
    .cta-scrim { position:absolute; inset:0; background:rgba(20,18,15,.7); }
    .cta-content { position:relative; width:100%; padding:clamp(64px,7vw,110px) clamp(28px,4vw,64px); display:flex; flex-direction:column; align-items:center; gap:28px; text-align:center; }
    .cta-content h2 { max-width:22ch; font-weight:800; font-size:clamp(36px,5.2vw,82px); line-height:.96; letter-spacing:-.04em; color:#F0EADF; text-wrap:balance; }
    .cta-content p { margin:0; max-width:520px; font-size:17px; line-height:1.7; color:rgba(240,234,223,.78); }
    .cta-ctas { display:flex; flex-wrap:wrap; gap:12px; justify-content:center; }

    footer.site-footer { padding:clamp(20px,2.4vw,32px) clamp(16px,3vw,48px) 0; }
    .footer-panel { position:relative; overflow:hidden; max-width:1240px; margin:0 auto; min-height:540px; display:flex; flex-direction:column; border-radius:var(--fl-r); }
    .footer-back { position:absolute; inset:0; background:var(--fl-footer-back); }
    .footer-stripe { position:absolute; top:0; bottom:0; left:3%; right:0; background:var(--fl-accent); border-radius:220px 14px 14px 220px; }
    .footer-grid { position:relative; padding:clamp(48px,5vw,72px) clamp(28px,4vw,52px) 0 clamp(60px,14vw,220px); display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:44px 36px; align-items:start; }
    .footer-grid .col { min-width:0; display:flex; flex-direction:column; gap:11px; }
    .footer-grid .brand p:first-child { margin:0; font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:21px; font-weight:700; letter-spacing:-.03em; line-height:1.2; color:#F4EFE6; max-width:280px; }
    .footer-grid .brand p:last-child { margin:0; font-size:12px; line-height:1.6; color:rgba(244,239,230,.72); }
    .footer-grid .col-title { font-size:11px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:#F4EFE6; }
    .footer-grid a, .footer-grid span.item { font-size:14px; color:rgba(244,239,230,.84); }
    .footer-grid a:hover { color:#F4EFE6; }
    .footer-grid a.wa-chip { display:inline-flex; align-items:center; gap:10px; padding:14px 24px; border-radius:999px; background:#F4EFE6; color:var(--fl-accent); font-size:13px; font-weight:700; white-space:nowrap; align-self:flex-start; }
    .footer-grid a.wa-chip:hover { background:var(--fl-accent); color:#F4EFE6; transform:translateY(-2px); }
    .socials { display:flex; gap:10px; }
    .socials a { width:42px; height:42px; border-radius:999px; background:rgba(13,12,10,.32); color:#F4EFE6; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; }
    .socials a:hover { background:#0D0C0A; transform:translateY(-3px); }
    .footer-wordmark { position:relative; margin-top:auto; padding:48px clamp(28px,4vw,52px) 20px clamp(60px,14vw,220px); display:flex; justify-content:flex-end; }
    .footer-wordmark span { display:block; font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:clamp(64px,14vw,210px); font-weight:800; line-height:.9; letter-spacing:-.055em; color:#F4EFE6; white-space:nowrap; }

    .wa-float { position:fixed; right:24px; bottom:24px; z-index:70; display:inline-flex; align-items:center; padding:16px 28px; border-radius:999px; background:var(--fl-ink); color:var(--fl-surface); font-size:13px; font-weight:600; box-shadow:0 14px 34px rgba(13,12,10,.34); }
    .wa-float:hover { background:var(--fl-accent); color:#F4EFE6; transform:translateY(-3px); }

    [data-reveal] { opacity:0; transform:translateY(22px); transition:opacity .9s cubic-bezier(.2,.8,.2,1), transform .9s cubic-bezier(.2,.8,.2,1); }
    [data-reveal].is-visible { opacity:1; transform:none; }

    .menu-btn { display:none; width:42px; height:42px; flex:0 0 auto; border-radius:999px; border:1px solid var(--fl-line); background:transparent; align-items:center; justify-content:center; flex-direction:column; gap:5px; cursor:pointer; padding:0; }
    .menu-btn span { display:block; width:18px; height:2px; background:var(--fl-ink); border-radius:2px; transition:transform .3s ease, opacity .3s ease; }
    .menu-btn.open span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
    .menu-btn.open span:nth-child(2) { opacity:0; }
    .menu-btn.open span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }

    .mobile-menu { position:fixed; inset:0; z-index:65; background:var(--fl-surface); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:36px; opacity:0; pointer-events:none; transition:opacity .3s ease; }
    .mobile-menu.open { opacity:1; pointer-events:auto; }
    .mobile-menu-links { display:flex; flex-direction:column; align-items:center; gap:22px; }
    .mobile-menu-links a { font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:30px; font-weight:700; letter-spacing:-.02em; color:var(--fl-ink); }
    .mobile-menu-wa { display:inline-flex; align-items:center; padding:16px 32px; border-radius:999px; background:var(--fl-accent); color:#F4EFE6; font-size:14px; font-weight:700; }

    @media (max-width: 860px) {
