<script>
  const menuBtn = document.getElementById("menuBtn");
  const mobileMenu = document.getElementById("mobileMenu");
  function closeMobileMenu() {
    mobileMenu?.classList.remove("open");
    menuBtn?.classList.remove("open");
    menuBtn?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }
  menuBtn?.addEventListener("click", () => {
    const open = mobileMenu?.classList.toggle("open");
    menuBtn.classList.toggle("open", open);
    menuBtn.setAttribute("aria-expanded", String(!!open));
    document.body.style.overflow = open ? "hidden" : "";
  });
  mobileMenu?.querySelectorAll("a").forEach(a => a.addEventListener("click", closeMobileMenu));

  const nav = document.getElementById("mainNav");
  const navPill = nav?.querySelector<HTMLElement>(".nav-pill");
  const navLinks = Array.from(nav?.querySelectorAll<HTMLAnchorElement>("a") ?? []);
  navLinks.forEach(link => {
    link.addEventListener("mouseenter", () => {
      if (!navPill) return;
      navPill.style.left = link.offsetLeft + "px";
      navPill.style.width = link.offsetWidth + "px";
      navPill.style.opacity = "1";
      navLinks.forEach(l => l.classList.toggle("is-hovered", l === link));
    });
  });
  nav?.addEventListener("mouseleave", () => {
    if (navPill) navPill.style.opacity = "0";
    navLinks.forEach(l => l.classList.remove("is-hovered"));
  });

  const SLIDE_MS = 6000;
  const bgs = Array.from(document.querySelectorAll<HTMLElement>(".hero-bg"));
  const thumbs = Array.from(document.querySelectorAll<HTMLElement>(".hero-thumb"));
  let current = 0;
  let start = performance.now();
  let raf = 0;

  function goTo(i: number) {
    current = i;
    start = performance.now();
    bgs.forEach((el, idx) => el.classList.toggle("active", idx === i));
    thumbs.forEach((el, idx) => {
      el.classList.toggle("active", idx === i);
      const bar = el.querySelector<HTMLElement>(".thumb-progress");
      if (bar) bar.style.width = idx < i ? "100%" : idx === i ? "0%" : "0%";
    });
  }

  function tick(now: number) {
    const elapsed = now - start;
    const pct = Math.min(elapsed / SLIDE_MS, 1);
    const bar = thumbs[current]?.querySelector<HTMLElement>(".thumb-progress");
    if (bar) bar.style.width = (pct * 100) + "%";
    if (pct >= 1) goTo((current + 1) % bgs.length);
    raf = requestAnimationFrame(tick);
  }

  if (bgs.length) {
    thumbs.forEach((el, i) => el.addEventListener("click", () => goTo(i)));
    raf = requestAnimationFrame(tick);
  }

  document.querySelectorAll<HTMLDetailsElement>(".faq-list details").forEach(details => {
    const summary = details.querySelector("summary")!;
    const answer = details.querySelector("p")!;
    let anim: Animation | null = null;
    let closing = false;
    let opening = false;

    summary.addEventListener("click", e => {
      e.preventDefault();
      details.style.overflow = "hidden";
      if (closing || !details.open) {
        openDetails();
      } else if (opening || details.open) {
        shrink();
      }
    });

    function shrink() {
      closing = true;
      const startHeight = details.offsetHeight + "px";
      const endHeight = summary.offsetHeight + "px";
      anim?.cancel();
      anim = details.animate({ height: [startHeight, endHeight] }, { duration: 280, easing: "cubic-bezier(.2,.8,.2,1)" });
      anim.onfinish = () => finish(false);
      anim.oncancel = () => (closing = false);
    }

    function openDetails() {
      details.style.height = details.offsetHeight + "px";
      details.open = true;
      requestAnimationFrame(expand);
    }

    function expand() {
      opening = true;
      const startHeight = details.offsetHeight + "px";
      const endHeight = summary.offsetHeight + answer.offsetHeight + "px";
      anim?.cancel();
      anim = details.animate({ height: [startHeight, endHeight] }, { duration: 280, easing: "cubic-bezier(.2,.8,.2,1)" });
      anim.onfinish = () => finish(true);
      anim.oncancel = () => (opening = false);
    }

    function finish(open: boolean) {
      details.open = open;
      anim = null;
      closing = false;
      opening = false;
      details.style.height = details.style.overflow = "";
    }
  });

  const revealEls = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
  revealEls.forEach(el => {
    const delay = el.getAttribute("data-delay");
    if (delay) el.style.transitionDelay = delay + "ms";
  });
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.06 });
    revealEls.forEach(el => io.observe(el));
    setTimeout(() => revealEls.forEach(el => el.classList.add("is-visible")), 3000);
  } else {
    revealEls.forEach(el => el.classList.add("is-visible"));
  }
</script>
</body>
</html>
