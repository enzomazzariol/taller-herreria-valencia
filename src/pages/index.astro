<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Flamingo Services — Herrería a medida en Valencia</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --fl-surface:#131110; --fl-panel:#1D1A17; --fl-ink:#F0EADF; --fl-body:rgba(240,234,223,.78);
      --fl-muted:rgba(240,234,223,.52); --fl-line:rgba(240,234,223,.16); --fl-accent:#C05A24;
      --fl-alt:#E6DFD3; --fl-on-alt:#14120F; --fl-alt-body:#443E35; --fl-alt-muted:#756E62;
      --fl-alt-line:rgba(20,18,15,.18); --fl-alt-soft:rgba(20,18,15,.05); --fl-footer-back:#131110; --fl-r:32px;
    }
    html { scroll-behavior: smooth; }
    body { margin:0; background:var(--fl-surface); color:var(--fl-ink); font-family:Archivo,system-ui,sans-serif; -webkit-font-smoothing:antialiased; }
    a { text-decoration:none; transition:color .35s ease, background-color .4s ease, border-color .4s ease, transform .4s ease; }
    details > summary::-webkit-details-marker { display:none }
    .wrap { padding:0 clamp(12px,1.6vw,22px) clamp(12px,1.6vw,22px); }

    .header { position:sticky; top:14px; z-index:60; margin:14px 0 0; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:14px 30px; padding:14px 22px 14px 26px; border-radius:999px; background:color-mix(in srgb, var(--fl-panel) 72%, transparent); border:1px solid var(--fl-line); box-shadow:0 10px 30px rgba(20,18,15,.07); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); }
    .logo { display:flex; align-items:center; color:var(--fl-ink); }
    .logo img { height:26px; width:auto; display:block; }
    .nav { position:relative; display:flex; flex-wrap:wrap; align-items:center; gap:4px; }
    .nav-pill { position:absolute; top:50%; height:38px; margin-top:-19px; border-radius:999px; background:var(--fl-ink); pointer-events:none; opacity:0; transition:left .45s cubic-bezier(.2,.8,.2,1), width .45s cubic-bezier(.2,.8,.2,1), opacity .3s ease; }
    .nav a { position:relative; z-index:1; padding:10px 17px; border-radius:999px; font-size:12.5px; font-weight:600; letter-spacing:.09em; text-transform:uppercase; white-space:nowrap; color:var(--fl-ink); transition:color .35s ease; }
    .nav a.is-hovered { color:var(--fl-panel); }
    .wa-pill { display:inline-flex; align-items:center; gap:10px; padding:12px 22px; border-radius:999px; background:var(--fl-accent); color:#F4EFE6; font-size:13px; font-weight:700; letter-spacing:.06em; white-space:nowrap; }
    .wa-pill:hover { background:var(--fl-ink); color:var(--fl-panel); transform:translateY(-2px); }
    .wa-pill .dot { width:7px; height:7px; border-radius:999px; background:currentColor; display:block; }

    .hero { position:relative; margin-top:-64px; padding-top:64px; min-height:88vh; display:flex; align-items:flex-end; overflow:hidden; border-radius:var(--fl-r); background:#1B1814; }
    .hero-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity 1.2s cubic-bezier(.4,0,.2,1); }
    .hero-bg.active { opacity:1; }
    .hero-scrim { position:absolute; inset:0; background:linear-gradient(180deg,rgba(20,18,15,.55) 0%,rgba(20,18,15,.16) 34%,rgba(20,18,15,.88) 100%); }
    .hero-inner { position:relative; width:100%; padding:clamp(40px,5vw,72px) clamp(28px,4vw,64px) clamp(32px,3.6vw,48px); display:grid; grid-template-columns:minmax(0,1fr) auto; gap:44px; align-items:end; }
    .hero-copy { min-width:0; display:flex; flex-direction:column; gap:26px; max-width:920px; }
    .eyebrow { font-size:11px; font-weight:600; letter-spacing:.3em; text-transform:uppercase; color:rgba(240,234,223,.7); }
    .hero h1 { margin:0; max-width:19ch; font-family:'Bricolage Grotesque',Archivo,sans-serif; font-weight:800; font-size:clamp(42px,5.8vw,104px); line-height:.92; letter-spacing:-.035em; color:#F0EADF; text-wrap:balance; }
    .hero p { margin:0; max-width:470px; font-size:17px; line-height:1.6; color:rgba(240,234,223,.82); }
    .hero-ctas { display:flex; flex-wrap:wrap; gap:12px; padding-top:6px; }
    .btn-light { display:inline-flex; align-items:center; padding:18px 34px; border-radius:999px; background:#F0EADF; color:#14120F; font-size:14px; font-weight:600; white-space:nowrap; }
    .btn-light:hover { background:var(--fl-accent); color:#F4EFE6; transform:translateY(-3px); }
    .btn-ghost { display:inline-flex; align-items:center; padding:18px 32px; border-radius:999px; border:1px solid rgba(240,234,223,.42); color:#F0EADF; font-size:14px; font-weight:500; white-space:nowrap; }
    .btn-ghost:hover { border-color:#F0EADF; background:rgba(240,234,223,.14); transform:translateY(-3px); }

    .hero-thumbs { display:flex; gap:10px; align-items:flex-end; }
    .hero-thumb { position:relative; padding:0; border:none; background:none; cursor:pointer; width:104px; display:block; transition:transform .5s cubic-bezier(.2,.8,.2,1); }
    .hero-thumb:hover { transform:translateY(-5px); }
    .thumb-track { display:block; height:3px; border-radius:999px; background:rgba(240,234,223,.28); overflow:hidden; }
    .thumb-progress { display:block; height:3px; border-radius:999px; background:#F0EADF; width:0%; }
    .thumb-img-wrap { display:block; height:72px; margin-top:10px; overflow:hidden; border-radius:14px; }
    .thumb-img-wrap img { width:100%; height:100%; object-fit:cover; display:block; transition:opacity .6s ease; opacity:.5; }
    .hero-thumb.active .thumb-img-wrap img { opacity:1; }

    section#catalogo { padding:clamp(72px,8vw,124px) clamp(16px,3vw,48px) clamp(56px,6vw,96px); }
    .catalogo-head { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:32px 64px; align-items:end; max-width:1140px; margin:0 auto clamp(40px,4.5vw,64px); }
    h2 { margin:0; font-family:'Bricolage Grotesque',Archivo,sans-serif; font-weight:700; letter-spacing:-.035em; color:var(--fl-ink); }
    .catalogo-head h2 { font-size:clamp(34px,3.8vw,58px); line-height:1; }
    .catalogo-head p { margin:0; max-width:400px; font-size:16px; line-height:1.7; color:var(--fl-body); }
    .btn-outline { display:inline-flex; align-items:center; padding:16px 30px; border-radius:999px; border:1px solid var(--fl-ink); color:var(--fl-ink); font-size:12px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; }
    .btn-outline:hover { background:var(--fl-ink); color:var(--fl-surface); transform:translateY(-3px); }

    .productos { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr)); gap:clamp(18px,2vw,26px); max-width:1140px; margin:0 auto; }
    .producto { min-width:0; display:flex; flex-direction:column; overflow:hidden; border-radius:var(--fl-r); background:var(--fl-panel); border:1px solid var(--fl-line); transition:transform .6s cubic-bezier(.2,.8,.2,1), box-shadow .6s cubic-bezier(.2,.8,.2,1); }
    .producto:hover { transform:translateY(-6px); box-shadow:0 26px 60px rgba(20,18,15,.16); }
    .producto-media { position:relative; overflow:hidden; background:#D3CABA; aspect-ratio:16/10; }
    .producto-media img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; transition:transform 1.1s cubic-bezier(.2,.8,.2,1); }
    .producto:hover .producto-media img { transform:scale(1.05); }
    .producto-cta-wrap { position:absolute; left:18px; right:18px; bottom:18px; display:flex; justify-content:flex-end; pointer-events:none; }
    .producto-cta { pointer-events:auto; opacity:0; transform:translateY(14px); transition:transform .6s cubic-bezier(.2,.85,.2,1), opacity .5s ease; display:inline-flex; align-items:center; padding:13px 22px; border-radius:999px; background:#F0EADF; color:#14120F; font-size:11px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; white-space:nowrap; }
    .producto:hover .producto-cta { opacity:1; transform:translateY(0); }
    .producto-cta:hover { background:var(--fl-accent); color:#F4EFE6; }
    .producto-tag { position:absolute; top:18px; left:18px; padding:9px 16px; border-radius:999px; background:rgba(20,18,15,.55); backdrop-filter:blur(6px); color:#F0EADF; font-size:10.5px; font-weight:600; letter-spacing:.18em; text-transform:uppercase; }
    .producto-body { padding:clamp(26px,2.4vw,34px) clamp(24px,2.2vw,34px) clamp(28px,2.4vw,34px); display:flex; flex-direction:column; gap:22px; flex:1; }
    .producto-body h3 { margin:0; font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:26px; font-weight:700; letter-spacing:-.03em; color:var(--fl-ink); }
    .tarifas { display:flex; flex-direction:column; gap:2px; }
    .tarifa-row { display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding:11px 0; border-bottom:1px solid var(--fl-line); }
    .tarifa-row .q { font-size:14px; color:var(--fl-body); }
    .tarifa-row .v { font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:20px; font-weight:700; letter-spacing:-.03em; text-align:right; color:var(--fl-ink); }
    .incluye-label { font-size:11px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:var(--fl-muted); }
    .incluye-list { margin:12px 0 0; padding:0; list-style:none; display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:9px 22px; }
    .incluye-list li { display:flex; gap:10px; font-size:14px; line-height:1.5; color:var(--fl-body); }
    .incluye-list li span { color:var(--fl-accent); }
    .producto-body .btn-solid { margin-top:auto; display:inline-flex; align-items:center; justify-content:center; padding:16px 24px; border-radius:999px; background:var(--fl-ink); color:var(--fl-surface); font-size:11px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; }
    .producto-body .btn-solid:hover { background:var(--fl-accent); color:#F4EFE6; }

    section.segmentos-sec { padding:0 clamp(16px,3vw,48px) clamp(72px,8vw,120px); }
    .segmentos-head { display:flex; align-items:flex-end; justify-content:space-between; gap:32px; flex-wrap:wrap; margin:0 auto clamp(32px,3.6vw,52px); max-width:1140px; }
    .segmentos-head h2 { font-size:clamp(32px,3.6vw,54px); line-height:1; max-width:560px; }
    .segmentos-head p { margin:0; max-width:340px; font-size:15px; line-height:1.7; color:var(--fl-body); }
    .segmentos { max-width:1140px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr)); gap:clamp(18px,2vw,26px); }
    .segmento { min-width:0; display:flex; flex-direction:column; gap:20px; color:var(--fl-ink); }
    .segmento-media { overflow:hidden; background:#D3CABA; aspect-ratio:16/10; border-radius:24px; transition:border-radius .7s cubic-bezier(.2,.8,.2,1); }
    .segmento:hover .segmento-media { border-radius:24px 120px 24px 24px; }
    .segmento-media img { width:100%; height:100%; object-fit:cover; display:block; transition:transform 1.1s cubic-bezier(.2,.8,.2,1); }
    .segmento:hover .segmento-media img { transform:scale(1.04); }
    .segmento-title { display:flex; align-items:center; gap:16px; }
    .segmento-title .t { font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:27px; font-weight:700; letter-spacing:-.03em; white-space:nowrap; }
    .segmento-line { flex:1; min-width:0; display:flex; align-items:center; overflow:hidden; }
    .segmento-line span { height:1px; background:currentColor; opacity:.5; width:26px; transition:width .7s cubic-bezier(.2,.8,.2,1); display:block; }
    .segmento:hover .segmento-line span { width:100%; }
    .segmento-arrow { font-size:13px; line-height:1; transition:transform .5s cubic-bezier(.2,.8,.2,1); display:inline-block; }
    .segmento:hover .segmento-arrow { transform:translateX(5px); }
    .segmento p { margin:-6px 0 0; font-size:15px; line-height:1.7; color:var(--fl-body); max-width:440px; }

    section#taller { padding:0 clamp(16px,3vw,48px) clamp(20px,2.4vw,32px); }
    .taller-grid { max-width:1240px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr)); gap:clamp(18px,2vw,26px); align-items:stretch; }
    .taller-media { min-width:0; overflow:hidden; border-radius:var(--fl-r) var(--fl-r) var(--fl-r) clamp(60px,12vw,180px); background:#D3CABA; min-height:520px; }
    .taller-media img { width:100%; height:100%; object-fit:cover; display:block; min-height:520px; }
    .taller-card { min-width:0; padding:clamp(36px,4vw,64px) clamp(28px,3vw,52px); border-radius:var(--fl-r); background:var(--fl-panel); border:1px solid var(--fl-line); display:flex; flex-direction:column; gap:24px; justify-content:center; }
    .taller-card h2 { font-size:clamp(32px,3.6vw,54px); line-height:1; }
    .taller-card p { margin:0; max-width:520px; font-size:17px; line-height:1.75; color:var(--fl-body); }
    .cifras { display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:14px; margin-top:8px; }
    .cifra { min-width:0; padding:20px 20px 22px; border-radius:20px; background:var(--fl-surface); }
    .cifra .n { font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:40px; font-weight:800; letter-spacing:-.04em; line-height:1; color:var(--fl-ink); }
    .cifra .t { font-size:11px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; color:var(--fl-muted); margin-top:10px; }

    section#porque { padding:clamp(20px,2.4vw,32px) clamp(16px,3vw,48px); }
    .porque-panel { position:relative; overflow:hidden; max-width:1240px; margin:0 auto; padding:clamp(56px,6vw,96px) clamp(28px,4vw,72px) clamp(60px,6vw,100px) clamp(28px,7vw,120px); border-radius:var(--fl-r) var(--fl-r) clamp(60px,12vw,180px) var(--fl-r); background:var(--fl-alt); }
    .porque-head { display:flex; flex-direction:column; gap:16px; margin-bottom:clamp(40px,4.5vw,64px); max-width:620px; }
    .porque-head span { font-size:11px; font-weight:600; letter-spacing:.3em; text-transform:uppercase; color:var(--fl-alt-muted); }
    .porque-head h2 { font-size:clamp(32px,3.8vw,56px); line-height:1; color:var(--fl-on-alt); }
    .pilares { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr)); gap:clamp(18px,2vw,28px); }
    .pilar { min-width:0; padding:clamp(28px,2.6vw,36px) clamp(24px,2.2vw,32px) clamp(32px,3vw,40px); border-radius:24px; border:1px solid var(--fl-alt-line); display:flex; flex-direction:column; gap:18px; transition:border-color .6s ease, background-color .6s cubic-bezier(.2,.8,.2,1), transform .6s cubic-bezier(.2,.8,.2,1); }
    .pilar:hover { background:var(--fl-alt-soft); transform:translateY(-6px); }
    .pilar .icon-badge { width:54px; height:54px; border-radius:999px; border:1px solid var(--fl-alt-line); display:flex; align-items:center; justify-content:center; color:var(--fl-on-alt); }
    .pilar h3 { margin:0; font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:24px; font-weight:700; letter-spacing:-.025em; color:var(--fl-on-alt); }
    .pilar p { margin:0; font-size:16px; line-height:1.7; color:var(--fl-alt-body); }

    section#trabajos { padding:clamp(72px,8vw,124px) clamp(16px,3vw,48px) clamp(56px,6vw,88px); }
    .trabajos-head { max-width:1240px; margin:0 auto clamp(32px,3.6vw,48px); display:flex; align-items:flex-end; justify-content:space-between; gap:32px; flex-wrap:wrap; }
    .trabajos-head h2 { font-size:clamp(32px,3.8vw,56px); line-height:1; }
    .trabajos-head p { margin:0; max-width:330px; font-size:15px; line-height:1.7; color:var(--fl-body); }
