---
import content from '../data/content.json';
const steps = content.process;
const wa = content.contact.whatsapp;
const waMsg = encodeURIComponent(content.contact.whatsapp_message);

const seeds = ['yunque-consulta', 'yunque-diseno', 'yunque-forja-proceso', 'yunque-instalacion'];
---

<section id="proceso" class="process-section">
  <div class="container">
    <div class="section-eyebrow" data-reveal>
      <span class="eyebrow-tag">02 — Proceso</span>
      <div class="eyebrow-rule"></div>
    </div>

    <div class="steps-row" data-reveal>
      {steps.map((step, i) => (
        <div class:list={['step', i === 2 && 'step--forge']} data-reveal data-reveal-delay={100 + i * 80}>
          <div class="step-photo">
            <img
              src={`https://picsum.photos/seed/${seeds[i]}/500/500`}
              alt=""
              loading="lazy"
              onerror="this.remove()"
            />
          </div>
          <span class="step-num">{String(step.step).padStart(2, '0')}</span>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.description}</p>
        </div>
      ))}
    </div>

    <div class="process-cta" data-reveal>
      <a
        href={`https://wa.me/${wa}?text=${waMsg}`}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-btn"
      >
        Solicitar presupuesto gratis
      </a>
      <span class="cta-note">Respuesta en menos de 24 horas</span>
    </div>
  </div>
</section>

<style>
  .process-section {
    padding: 0 clamp(1.5rem, 4vw, 3rem) var(--section-py);
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
  }

  .section-eyebrow {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .eyebrow-tag {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-copper);
    white-space: nowrap;
  }

  .eyebrow-rule {
    flex: 1;
    height: 1px;
    background: var(--color-forge-border);
  }

  .steps-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .step {
    padding: 1rem;
    border: 1px solid transparent;
    transition: transform 0.5s var(--ease-spring), border-color 0.5s var(--ease-spring), background 0.5s var(--ease-spring);
  }

  .step:hover {
    transform: scale(1.045);
    border-color: var(--color-forge-border);
    background: var(--color-forge-iron);
    z-index: 2;
    position: relative;
  }

  .step--forge:hover {
    border-color: rgba(217, 123, 63, 0.4);
  }

  .step-photo {
    height: 220px;
    overflow: hidden;
    margin-bottom: 1.125rem;
    position: relative;
  }

  .step-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.6);
    transform: scale(1.08);
    transition: transform 0.6s var(--ease-spring), filter 0.6s var(--ease-spring);
  }

  .step:hover .step-photo img {
    transform: scale(1);
    filter: saturate(0.85);
  }

  .step-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.5rem;
    color: var(--color-forge-border);
    line-height: 1;
    transition: color 0.4s var(--ease-spring);
  }

  .step:hover .step-num { color: var(--color-copper); }

  .step-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-forge-smoke);
    margin: 0.5rem 0 0.375rem;
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-forge-muted);
  }

  .process-cta {
    text-align: center;
    margin-top: 3.5rem;
  }

  .cta-btn {
    display: inline-block;
    background: var(--color-copper);
    color: var(--color-forge-black);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    padding: 1rem 1.875rem;
    transition: background 0.3s var(--ease-spring);
  }

  .cta-btn:hover { background: var(--color-copper-light); }

  .cta-note {
    display: block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--color-forge-muted);
    margin-top: 0.75rem;
  }

  @media (max-width: 900px) {
    .steps-row { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .step:hover { transform: none; }
  }

  @media (max-width: 480px) {
    .steps-row { grid-template-columns: 1fr; }
  }
</style>
