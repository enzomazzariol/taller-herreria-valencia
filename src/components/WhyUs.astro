---
import content from '../data/content.json';
const wa = content.contact.whatsapp;
const waMsg = encodeURIComponent(content.contact.whatsapp_message);
const reasons = content.reasons;

const stats = [content.stats[0], content.stats[1], content.stats[3]].map((s) => ({
  value: `${s.value}${s.suffix}`,
  label: s.label,
}));
---

<section id="quienes-somos" class="whyus-section">
  <div class="container">
    <div class="grid" data-reveal>
      <div class="statement">
        <h2>Cada pieza lleva el mismo compromiso: instalarse una vez y no volver al taller.</h2>
        <p>Trabajamos con planos firmados, materiales certificados y mano de obra propia, sin subcontratar la soldadura. Cada proyecto sale del taller con garantía escrita.</p>
      </div>

      <div class="stats">
        {stats.map((s) => (
          <div class="stat">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="reasons" data-reveal>
      {reasons.map((r) => (
        <div class="reason">
          <h3>{r.title}</h3>
          <p>{r.description}</p>
        </div>
      ))}
    </div>

    <a
      href={`https://wa.me/${wa}?text=${waMsg}`}
      target="_blank"
      rel="noopener noreferrer"
      class="cta-btn"
      data-reveal
    >
      Solicitar presupuesto
    </a>
  </div>
</section>

<style>
  .whyus-section {
    padding: 0 clamp(1.5rem, 4vw, 3rem) var(--section-py);
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 4rem;
    align-items: start;
  }

  .statement h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    line-height: 1.2;
    color: var(--color-forge-smoke);
    margin-bottom: 1.25rem;
  }

  .statement p {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-forge-muted);
    max-width: 440px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .stat {
    border-left: 1px solid var(--color-forge-border);
    padding: 0 1.75rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.4s var(--ease-spring);
  }

  .stat:hover {
    border-color: var(--color-copper);
  }

  .stat-value {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 3.5rem;
    color: var(--color-copper);
    line-height: 1;
    margin-bottom: 0.75rem;
    transition: transform 0.4s var(--ease-spring);
  }

  .stat:hover .stat-value {
    transform: translateX(4px);
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-forge-muted);
  }

  .reasons {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-forge-border);
  }

  .reason h3 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-forge-smoke);
    margin-bottom: 0.5rem;
  }

  .reason p {
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-forge-muted);
  }

  .cta-btn {
    display: inline-block;
    white-space: nowrap;
    margin-top: 3rem;
    background: var(--color-copper);
    color: var(--color-forge-black);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    padding: 1rem 1.875rem;
    transition: background 0.3s var(--ease-spring), transform 0.3s var(--ease-spring);
  }

  .cta-btn:hover { background: var(--color-copper-light); transform: translateY(-2px); }
  .cta-btn:active { transform: translateY(0) scale(0.97); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .stats { grid-template-columns: 1fr; gap: 1.5rem; }
    .stat { border-left: none; border-top: 1px solid var(--color-forge-border); padding: 1.5rem 0 0; }
    .reasons { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }

  @media (max-width: 560px) {
    .reasons { grid-template-columns: 1fr; }
  }
</style>
