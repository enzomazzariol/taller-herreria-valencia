---
import content from '../data/content.json';
const wa = content.contact.whatsapp;
const waMsg = encodeURIComponent(content.contact.whatsapp_message);

const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#precios',   label: 'Precios' },
  { href: '#cotizador', label: 'Cotizador' },
  { href: '#galeria',   label: 'Galería' },
  { href: '#contacto',  label: 'Contacto' },
];
---

<header id="navbar" class="navbar">
  <div class="nav-pill">
    <a href="/" class="nav-logo" aria-label="Flamingo Services">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="4" fill="#E8501A"/>
        <path d="M8 24V10h10a6 6 0 010 12H8z" fill="white" opacity="0.15"/>
        <path d="M9 23V11h8.5a5 5 0 010 10H9" stroke="white" stroke-width="1.5" fill="none"/>
        <circle cx="22" cy="10" r="2" fill="#C9A24A"/>
      </svg>
      <span class="nav-logo-text">
        <span class="logo-main">Flamingo</span>
        <span class="logo-sub">Herrería · Valencia</span>
      </span>
    </a>

    <nav class="nav-links" aria-label="Navegación principal">
      {links.map((link, i) => (
        <a href={link.href} class="nav-link" style={`transition-delay:${i * 0.04}s`}>{link.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a
        href={`https://wa.me/${wa}?text=${waMsg}`}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-cta"
      >
        <span>Presupuesto gratis</span>
        <span class="cta-icon-wrap">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </a>
      <button id="menu-toggle" class="hamburger" aria-label="Abrir menú" aria-expanded="false">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div id="menu-overlay" class="menu-overlay" aria-hidden="true">
    <nav class="menu-links">
      {links.map((link, i) => (
        <a
          href={link.href}
          class="menu-link"
          style={`--stagger:${i}`}
        >
          <span class="menu-link-num" aria-hidden="true">0{i + 1}</span>
          <span class="menu-link-text">{link.label}</span>
          <span class="menu-link-arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17l10-10M7 7h10v10"/>
            </svg>
          </span>
        </a>
      ))}
    </nav>
    <div class="menu-footer">
      <a
        href={`https://wa.me/${wa}?text=${waMsg}`}
        target="_blank"
        rel="noopener noreferrer"
        class="menu-cta"
      >
        Solicitar presupuesto gratis
        <span class="cta-icon-wrap">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </a>
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar')!;
  const toggle = document.getElementById('menu-toggle')!;
  const overlay = document.getElementById('menu-overlay')!;

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    overlay.setAttribute('aria-hidden', String(open));
    toggle.classList.toggle('is-open', !open);
    overlay.classList.toggle('is-open', !open);
    document.body.style.overflow = open ? '' : 'hidden';
  });

  overlay.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', 'false');
      overlay.setAttribute('aria-hidden', 'true');
      toggle.classList.remove('is-open');
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
      toggle.click();
    }
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    padding-top: 1.25rem;
    z-index: 100;
    pointer-events: none;
  }

  .nav-pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.625rem 0.75rem 0.625rem 1.25rem;
    background: rgba(10, 10, 10, 0.75);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    transition: background 0.6s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), border-color 0.6s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), box-shadow 0.6s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .nav-pill:hover {
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo-main {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-forge-smoke);
    letter-spacing: -0.01em;
  }

  .logo-sub {
    font-family: var(--font-body);
    font-size: 0.5rem;
    color: var(--color-forge-subtle);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    border-radius: 9999px;
    transition: color 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), background 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--color-forge-smoke);
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    color: white;
    background: var(--color-copper);
    text-decoration: none;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border-radius: 9999px;
    transition: background 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), transform 0.3s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: var(--color-copper-light);
  }

  .nav-cta:active {
    transform: scale(0.97);
  }

  .cta-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.2);
    transition: transform 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .nav-cta:hover .cta-icon-wrap {
    transform: translateX(2px) scale(1.05);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    gap: 5px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    cursor: pointer;
    padding: 0;
    transition: background 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .hamburger:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .hamburger span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--color-forge-smoke);
    border-radius: 2px;
    transition: transform 0.5s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), opacity 0.3s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
    transform-origin: center;
  }

  .hamburger span:nth-child(2) {
    width: 10px;
    align-self: flex-end;
  }

  .hamburger.is-open span:nth-child(1) {
    transform: translateY(3.25px) rotate(45deg);
    width: 16px;
  }

  .hamburger.is-open span:nth-child(2) {
    transform: translateY(-3.25px) rotate(-45deg);
    width: 16px;
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 2.5rem 4rem;
    background: rgba(5, 5, 5, 0.92);
    backdrop-filter: blur(48px);
    -webkit-backdrop-filter: blur(48px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .menu-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .menu-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 600px;
    margin: 0 auto;
    width: 100%;
  }

  .menu-link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    text-decoration: none;
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    border: 1px solid transparent;
    transition: border-color 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), background 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), transform 0.6s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), border-color 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), background 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
    transition-delay: calc(var(--stagger) * 0.08s);
  }

  .menu-overlay.is-open .menu-link {
    opacity: 1;
    transform: translateY(0);
  }

  .menu-link:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .menu-link-num {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-style: italic;
    color: var(--color-copper);
    opacity: 0.5;
    width: 2rem;
    flex-shrink: 0;
  }

  .menu-link-text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--color-forge-smoke);
    letter-spacing: -0.03em;
    line-height: 1.1;
    flex: 1;
  }

  .menu-link-arrow {
    color: var(--color-forge-muted);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), transform 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .menu-link:hover .menu-link-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-copper);
  }

  .menu-footer {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), transform 0.6s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
    transition-delay: 0.4s;
  }

  .menu-overlay.is-open .menu-footer {
    opacity: 1;
    transform: translateY(0);
  }

  .menu-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    color: white;
    background: var(--color-copper);
    text-decoration: none;
    padding: 0.75rem 0.75rem 0.75rem 1.5rem;
    border-radius: 9999px;
    transition: background 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), transform 0.3s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .menu-cta:hover {
    background: var(--color-copper-light);
  }

  .menu-cta:active {
    transform: scale(0.97);
  }

  .menu-cta .cta-icon-wrap {
    width: 2rem;
    height: 2rem;
    background: rgba(0, 0, 0, 0.2);
  }

  .menu-cta:hover .cta-icon-wrap {
    transform: translateX(2px) scale(1.05);
  }

  @media (max-width: 768px) {
    .navbar {
      padding-top: 0.75rem;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    .nav-pill {
      width: 100%;
      justify-content: space-between;
      padding: 0.5rem 0.5rem 0.5rem 1rem;
      gap: 0.5rem;
      border-radius: 1.25rem;
    }

    .nav-links { display: none; }
    .nav-cta { display: none; }
    .hamburger { display: flex; }

    .menu-overlay {
      padding: 5rem 1.25rem 2rem;
    }

    .menu-link {
      padding: 1rem 1.25rem;
      gap: 0.75rem;
    }

    .menu-link-text {
      font-size: 1.5rem;
    }

    .menu-link-num {
      display: none;
    }
  }
</style>
