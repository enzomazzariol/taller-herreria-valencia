---
import { waGeneral } from "../data/site";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";
---

<footer class="site-footer">
  <div class="footer-panel">
    <div class="footer-back"></div>
    <div class="footer-stripe"></div>
    <div class="footer-grid">
      <div class="col brand">
        <p>Hierro hecho a mano en Valencia, desde 1994.</p>
        <p>© 2026 Flamingo Services · Todos los derechos reservados</p>
      </div>
      <div class="col">
        <span class="col-title">Catálogo</span>
        <a href="#catalogo">Techos de estacionamiento</a>
        <a href="#catalogo">Puertas de seguridad</a>
        <a href="#catalogo">Pérgolas</a>
        <a href="#catalogo">Portones</a>
        <a href="#trabajos">Trabajos entregados</a>
      </div>
      <div class="col">
        <span class="col-title">Taller</span>
        <a href="#taller">Quiénes somos</a>
        <span class="item">Valencia y todo Carabobo</span>
        <span class="item">Maracay · Caracas</span>
        <span class="item">Lunes a sábado · 8:00 a 5:00</span>
        <span class="item">Presupuesto sin costo</span>
      </div>
      <div class="col">
        <span class="col-title">Pide tu presupuesto</span>
        <a href={waGeneral} target="_blank" rel="noopener" class="wa-chip">
          <WhatsAppIcon size={18} />
          <span>Escribir por WhatsApp</span>
        </a>
        <span class="col-title">Síguenos</span>
        <div class="socials">
          <a href="https://www.instagram.com/flamingoservices_/" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=61554200556790" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 8h-2a2 2 0 0 0-2 2v3H8v3h3v6h3v-6h2.5l.5-3h-3v-2a1 1 0 0 1 1-1h2z"/></svg>
          </a>
          <a href="tel:+584244715866" aria-label="Llamar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v4a2 2 0 0 1-2 2C9.5 21 3 14.5 3 6a2 2 0 0 1 1-2Z"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="footer-wordmark"><span>flamingo</span></div>
    <div class="footer-credit">
      <span>Hecho por</span>
      <img src="/logos/guarapo-media-logo.svg" alt="Guarapo Media" />
    </div>
  </div>
</footer>

<style>
  footer.site-footer { padding:clamp(20px,2.4vw,32px) clamp(16px,3vw,48px) 0; }
  .footer-panel { position:relative; overflow:hidden; max-width:1240px; margin:0 auto; min-height:540px; display:flex; flex-direction:column; border-radius:var(--fl-r); }
  .footer-back { position:absolute; inset:0; background:var(--fl-footer-back); }
  .footer-stripe { position:absolute; top:0; bottom:0; left:3%; right:0; background:var(--fl-accent); border-radius:220px 14px 14px 220px; }
  .footer-grid { position:relative; padding:clamp(48px,5vw,72px) clamp(28px,4vw,52px) 0 clamp(60px,14vw,220px); display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:44px 36px; align-items:start; }
  .footer-grid .col { min-width:0; display:flex; flex-direction:column; gap:11px; }
  .footer-grid .brand p:first-child { margin:0; font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:21px; font-weight:700; letter-spacing:-.03em; line-height:1.2; color:#F4EFE6; max-width:280px; }
  .footer-grid .brand p:last-child { margin:0; font-size:12px; line-height:1.6; color:rgba(244,239,230,.72); }
  .footer-grid .col-title { font-size:11px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:#F4EFE6; }
  .footer-grid a, .footer-grid span.item { font-size:14px; color:rgba(244,239,230,.84); }
  .footer-grid a:hover { color:#F4EFE6; }
  .footer-grid a.wa-chip { display:inline-flex; align-items:center; gap:10px; padding:14px 24px; border-radius:999px; background:#F4EFE6; color:var(--fl-accent); font-size:13px; font-weight:700; white-space:nowrap; align-self:flex-start; }
  .footer-grid a.wa-chip:hover { background:var(--fl-accent); color:#F4EFE6; transform:translateY(-2px); }
  .socials { display:flex; gap:10px; }
  .socials a { width:42px; height:42px; border-radius:999px; background:rgba(13,12,10,.32); color:#F4EFE6; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; }
  .socials a:hover { background:#0D0C0A; transform:translateY(-3px); }
  .footer-wordmark { position:relative; margin-top:auto; padding:48px clamp(28px,4vw,52px) 20px clamp(60px,14vw,220px); display:flex; justify-content:flex-end; }
  .footer-wordmark span { display:block; font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:clamp(64px,14vw,210px); font-weight:800; line-height:.9; letter-spacing:-.055em; color:#F4EFE6; white-space:nowrap; }

  .footer-credit { position:relative; display:flex; align-items:center; justify-content:center; gap:8px; padding:16px clamp(28px,4vw,52px) 22px; }
  .footer-credit span { font-family:Archivo,system-ui,sans-serif; font-size:13px; font-weight:500; color:rgba(244,239,230,.6); }
  .footer-credit img { height:34px; width:auto; display:block; opacity:.85; }

  @media (max-width: 860px) {
    .footer-grid { padding-left:clamp(24px,6vw,40px); gap:32px 24px; }
    .footer-stripe { left:0; border-radius:28px; }
    .footer-wordmark { padding-left:clamp(24px,6vw,40px); justify-content:flex-start; }
    .footer-wordmark span { font-size:16vw; }
  }
  @media (max-width: 480px) {
    .footer-wordmark span { font-size:13vw; }
  }
</style>
