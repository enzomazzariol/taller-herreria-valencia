---
import content from '../data/content.json';
const b = content.business;
const c = content.contact;
const waMsg = encodeURIComponent(c.whatsapp_message);

const navLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#precios', label: 'Precios' },
  { href: '#galeria', label: 'Galería' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#contacto', label: 'Contacto' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand" data-reveal>
        <a href="/" class="footer-logo" aria-label="Flamingo Services">
          <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="4" fill="#E8501A"/>
            <path d="M8 24V10h10a6 6 0 010 12H8z" fill="white" opacity="0.15"/>
            <path d="M9 23V11h8.5a5 5 0 010 10H9" stroke="white" stroke-width="1.5" fill="none"/>
            <circle cx="22" cy="10" r="2" fill="#C9A24A"/>
          </svg>
          <span class="footer-logo-text">Flamingo Services</span>
        </a>
        <p class="footer-desc">{b.description}</p>
        <div class="footer-social">
          <a href={c.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <circle cx="12" cy="12" r="5"/>
              <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href={c.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3V2z"/>
            </svg>
          </a>
          <a href={`https://wa.me/${c.whatsapp}?text=${waMsg}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="footer-col" data-reveal data-reveal-delay="100">
        <h4 class="footer-col-title">Navegación</h4>
        <nav aria-label="Enlaces del footer">
          {navLinks.map(link => (
            <a href={link.href} class="footer-link">{link.label}</a>
          ))}
        </nav>
      </div>

      <div class="footer-col" data-reveal data-reveal-delay="150">
        <h4 class="footer-col-title">Contacto</h4>
        <a href={`tel:${c.phone.replace(/\s/g, '')}`} class="footer-link footer-contact">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
          </svg>
          {c.phone}
        </a>
        <a href={`https://wa.me/${c.whatsapp}?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="footer-link footer-contact">
          <svg width="16" height="16" fill="currentColor" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Escríbenos
        </a>
      </div>

      <div class="footer-cta-col" data-reveal data-reveal-delay="200">
        <div class="footer-cta-db-outer">
          <div class="footer-cta-card">
            <h4 class="footer-col-title">¿Listo para empezar?</h4>
            <p class="footer-cta-text">
              Solicita tu presupuesto sin compromiso. Te respondemos en menos de 1 hora.
            </p>
            <a
              href={`https://wa.me/${c.whatsapp}?text=${waMsg}`}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-cta-btn"
            >
              <span>Solicitar presupuesto gratis</span>
              <span class="cta-icon-wrap">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </a>
            <span class="footer-cta-note">Sin compromiso · Respuesta en 1h</span>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} {b.name}. Todos los derechos reservados.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 5rem 2rem 0;
    background: var(--color-forge-carbon);
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 3rem;
    padding-bottom: 4rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    margin-bottom: 1.25rem;
  }

  .footer-logo-text {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-forge-smoke);
    letter-spacing: -0.01em;
  }

  .footer-desc {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-forge-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 38ch;
  }

  .footer-social {
    display: flex;
    gap: 0.75rem;
  }

  .footer-social a {
    color: var(--color-forge-muted);
    padding: 0.5rem;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    transition: color 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), border-color 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), background 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-social a:hover {
    color: var(--color-copper);
    border-color: rgba(232,80,26,0.3);
    background: rgba(232,80,26,0.06);
  }

  .footer-col-title {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-forge-muted);
    margin-bottom: 1.25rem;
  }

  .footer-col nav {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-link {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-forge-subtle);
    text-decoration: none;
    transition: color 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
    width: fit-content;
  }

  .footer-link:hover {
    color: var(--color-copper);
  }

  .footer-contact {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-forge-subtle);
    margin-bottom: 0.75rem;
  }

  .footer-contact svg {
    color: var(--color-copper);
    flex-shrink: 0;
  }

  .footer-cta-db-outer {
    padding: 0.375rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: calc(1.25rem + 0.375rem);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: border-color 0.5s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .footer-cta-db-outer:hover {
    border-color: rgba(232, 80, 26, 0.2);
  }

  .footer-cta-card {
    padding: 1.5rem;
    background: linear-gradient(160deg, rgba(232, 80, 26, 0.06), transparent 60%);
    border-radius: 1.25rem;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-cta-text {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-forge-muted);
    line-height: 1.6;
  }

  .footer-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: white;
    background: var(--color-copper);
    text-decoration: none;
    padding: 0.625rem 0.625rem 0.625rem 1.25rem;
    border-radius: 9999px;
    transition: background 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), transform 0.3s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
    width: fit-content;
  }

  .footer-cta-btn:hover {
    background: var(--color-copper-light);
  }

  .footer-cta-btn:active {
    transform: scale(0.97);
  }

  .footer-cta-btn .cta-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.2);
    transition: transform 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .footer-cta-btn:hover .cta-icon-wrap {
    transform: translateX(2px) scale(1.05);
  }

  .footer-cta-note {
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--color-forge-muted);
  }

  .footer-bottom {
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255,255,255,0.05);
    text-align: center;
  }

  .footer-bottom span {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-forge-muted);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-brand { grid-column: 1; }
    .footer { padding: 3rem 1.5rem 0; }
  }
</style>
