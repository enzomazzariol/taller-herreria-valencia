---
import content from '../data/content.json';
const b = content.business;
const c = content.contact;
const waMsg = encodeURIComponent(c.whatsapp_message);
---

<section class="cta-banner-section">
  <div class="cta-banner" data-reveal>
    <span class="cta-kicker"><span class="dot"></span>Listo para forjar</span>
    <h2>¿Necesitas un techo, portón<br class="br-desktop" /> o estructura a medida?</h2>
    <a href={`https://wa.me/${c.whatsapp}?text=${waMsg}`} target="_blank" rel="noopener noreferrer" class="cta-tag">
      <span class="cta-tag-icon">
        <img src="/taller-herreria-logo.png" alt="" />
      </span>
      <span>Solicitar presupuesto</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
    <a href={`tel:${c.phone.replace(/\s/g, '')}`} class="cta-call">Llámanos — {c.phone}</a>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand" data-reveal>
        <img src="/taller-herreria-logo.png" alt="Flamingo Services" class="footer-logo" />
        <p class="footer-desc">{b.description}</p>
      </div>

      <div class="footer-col" data-reveal>
        <span class="col-title">Servicios</span>
        <a href="#servicios">Techos para Estacionamiento</a>
        <a href="#servicios">Pérgolas</a>
        <a href="#servicios">Portones</a>
        <a href="#servicios">Puertas de Seguridad</a>
      </div>

      <div class="footer-col" data-reveal>
        <span class="col-title">Empresa</span>
        <a href="#proceso">Proceso</a>
        <a href="#precios">Precios</a>
        <a href="#galeria">Galería</a>
        <a href="#quienes-somos">Por qué Flamingo</a>
        <a href="#contacto">Contacto</a>
      </div>

      <div class="footer-col" data-reveal>
        <span class="col-title">Contacto</span>
        <span class="contact-line">Valencia, Carabobo</span>
        <span class="contact-line">Tel. {c.phone}</span>
        <span class="contact-line">{c.hours}</span>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {b.name}. Todos los derechos reservados.</span>
      <a href="https://guarapomedia.com/" target="_blank" rel="noopener noreferrer" class="made-by">
        <span>Hecho por</span>
        <img src="/guarapo-media-logo.svg" alt="Guarapo Media" />
      </a>
      <span>{c.coordinates} — Valencia, Carabobo</span>
    </div>
  </div>
</footer>

<style>
  .cta-banner-section {
     padding: 0 clamp(1.5rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
    max-width: 1600px;
    margin: 0 auto;
  }

  .cta-banner {
    position: relative;
    padding: clamp(4rem, 10vw, 7rem) clamp(1.75rem, 4vw, 3.5rem) clamp(5rem, 12vw, 8rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.75rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse 65% 55% at 8% 100%, rgba(0,0,0,0.55) 0%, transparent 60%),
      radial-gradient(ellipse 65% 55% at 92% 100%, rgba(0,0,0,0.55) 0%, transparent 60%),
      radial-gradient(ellipse 100% 150% at 50% -15%, #ead9c3 0%, var(--color-copper) 30%, var(--color-forge-black) 92%);
  }

  .cta-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-forge-black);
  }

  .cta-kicker .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-forge-black);
  }

  .cta-banner h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 3.4vw, 2.75rem);
    line-height: 1.2;
    color: var(--color-forge-black);
    max-width: 720px;
  }

  .cta-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    background: var(--color-forge-black);
    color: var(--color-forge-smoke);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.625rem 1.375rem 0.625rem 0.625rem;
    border: 1px solid var(--color-forge-black);
    transition: transform 0.3s var(--ease-spring), box-shadow 0.3s var(--ease-spring), background 0.3s var(--ease-spring);
  }

  .cta-tag:hover {
    transform: translateY(-2px);
    background: var(--color-forge-iron);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .cta-tag:active { transform: translateY(0) scale(0.97); }

  .cta-tag-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--color-copper);
    flex-shrink: 0;
  }

  .cta-tag-icon img {
    width: 65%;
    height: 65%;
    object-fit: contain;
  }

  .cta-call {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-forge-black);
    opacity: 0.75;
    text-decoration: none;
    transition: opacity 0.3s var(--ease-spring);
  }

  .cta-call:hover { opacity: 1; text-decoration: underline; }

  .footer {
    background: var(--color-forge-iron);
    border-top: 1px solid var(--color-forge-border);
    padding: 4.5rem clamp(1.5rem, 4vw, 3rem) 0;
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
  }

  .footer-logo {
    display: block;
    height: 38px;
    width: auto;
    margin-bottom: 1.125rem;
  }

  .footer-desc {
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-forge-muted);
    max-width: 280px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .col-title {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-forge-muted);
    margin-bottom: 0.5rem;
  }

  .footer-col a,
  .contact-line {
    font-family: var(--font-body);
    font-size: 0.84rem;
    color: var(--color-forge-muted);
    text-decoration: none;
    width: fit-content;
    transition: color 0.3s var(--ease-spring), transform 0.3s var(--ease-spring);
  }

  .footer-col a:hover { color: var(--color-copper); transform: translateX(3px); }

  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-forge-border);
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--color-forge-muted);
  }

  .footer-bottom > span:last-child {
    text-align: right;
  }

  .made-by {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .made-by img {
    height: 32px;
    width: auto;
  }

  @media (max-width: 640px) {
    .footer-bottom {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
    .footer-bottom > span:last-child { text-align: center; }
  }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
    .br-desktop { display: none; }
  }
</style>
