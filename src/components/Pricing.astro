---
import content from '../data/content.json';
const services = content.services;
const wa = content.contact.whatsapp;
---

<section id="precios" class="pricing-section">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-tag">Precios</span>
      <h2 class="section-title">
        Transparencia total.<br/>
        <em>Sin letra chica.</em>
      </h2>
      <p class="section-sub">
        Todos los precios incluyen materiales, pintura anticorrosiva e instalación.
        Lo que ves es lo que pagas.
      </p>
    </div>

    <div class="pricing-grid">
      {services.map((s, i) => (
        <div class="pricing-db" data-reveal data-reveal-delay={100 + i * 100}>
          <div class="pricing-db-outer" class:list={[i === 2 && 'featured-outer']}>
            <div class="pricing-card" class:list={[i === 2 && 'featured']}>
              {i === 2 && <div class="featured-badge">Más popular</div>}

              <div class="pricing-header">
                <h3 class="pricing-name">{s.name}</h3>
                <p class="pricing-desc">{s.description}</p>
              </div>

              <div class="pricing-tiers">
                {s.pricing.map((p) => (
                  <div class="tier">
                    <span class="tier-label">{p.label}</span>
                    {p.price ? (
                      <div class="tier-price">
                        <span class="tier-from">{p.prefix}</span>
                        <span class="tier-amount">
                          <span class="tier-currency">$</span>{p.price.toLocaleString()}
                        </span>
                      </div>
                    ) : (
                      <span class="tier-consult">A consultar</span>
                    )}
                  </div>
                ))}
              </div>

              <div class="pricing-includes">
                <span class="includes-title">Incluye</span>
                <ul class="includes-list">
                  {s.features.map(f => (
                    <li>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6L9 17l-5-5"/>
                      </svg>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href={`https://wa.me/${wa}?text=${encodeURIComponent('Hola, quiero un presupuesto para ' + s.name)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="pricing-cta"
                class:list={[i === 2 && 'pricing-cta--featured']}
              >
                <span>Solicitar presupuesto gratis</span>
                <span class="cta-icon-wrap">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="pricing-note" data-reveal>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 16v-4M12 8h.01"/>
      </svg>
      <p>
        ¿Proyecto grande o fuera de lista? <a href={`https://wa.me/${wa}?text=${encodeURIComponent('Hola, tengo un proyecto especial que me gustaría presupuestar')}`} target="_blank" rel="noopener noreferrer">Conversamos y te damos un presupuesto personalizado →</a>
      </p>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    padding: var(--section-py) 2rem;
    background: var(--color-forge-carbon);
    position: relative;
  }

  .pricing-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(232,80,26,0.4), transparent);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    max-width: 600px;
    margin-bottom: 4rem;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-copper);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    color: var(--color-forge-smoke);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 1rem;
  }

  .section-title em {
    font-style: italic;
    color: var(--color-copper);
  }

  .section-sub {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-forge-muted);
    line-height: 1.7;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .pricing-db-outer {
    height: 100%;
    padding: 0.375rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: calc(1.25rem + 0.375rem);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: border-color 0.5s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), background 0.5s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .pricing-db-outer:hover {
    border-color: rgba(232, 80, 26, 0.2);
    background: rgba(232, 80, 26, 0.03);
  }

  .pricing-db-outer.featured-outer {
    border-color: rgba(232, 80, 26, 0.3);
    background: rgba(232, 80, 26, 0.06);
  }

  .pricing-db-outer.featured-outer:hover {
    border-color: rgba(232, 80, 26, 0.4);
  }

  .pricing-card {
    position: relative;
    height: 100%;
    background: var(--color-forge-iron);
    border-radius: 1.25rem;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.06);
    transition: background 0.5s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .pricing-card.featured {
    background: linear-gradient(160deg, rgba(232, 80, 26, 0.08) 0%, var(--color-forge-iron) 40%);
  }

  .featured-badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-copper);
    color: white;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.9rem;
    border-radius: 0 0 8px 8px;
  }

  .pricing-header { flex-shrink: 0; }

  .pricing-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-forge-smoke);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .pricing-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-forge-muted);
    line-height: 1.6;
  }

  .pricing-tiers {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .tier {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .tier-label {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-forge-muted);
    flex-shrink: 0;
  }

  .tier-price {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .tier-from {
    font-family: var(--font-body);
    font-size: 0.65rem;
    color: var(--color-forge-muted);
    text-transform: lowercase;
  }

  .tier-amount {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    color: var(--color-forge-smoke);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .tier-currency {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-style: normal;
    color: var(--color-bronze);
    vertical-align: super;
  }

  .tier-consult {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-forge-subtle);
    font-style: italic;
  }

  .pricing-includes { flex: 1; }

  .includes-title {
    display: block;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-forge-muted);
    margin-bottom: 0.75rem;
  }

  .includes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .includes-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-forge-subtle);
    line-height: 1.4;
  }

  .includes-list svg {
    color: var(--color-copper);
    flex-shrink: 0;
    margin-top: 0.1em;
  }

  .pricing-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-forge-subtle);
    text-decoration: none;
    padding: 0.625rem 0.625rem 0.625rem 1.25rem;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 9999px;
    transition: color 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), border-color 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), background 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
    margin-top: auto;
    white-space: nowrap;
  }

  .pricing-cta:hover {
    color: var(--color-forge-smoke);
    border-color: rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.04);
  }

  .pricing-cta .cta-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    transition: transform 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1)), background 0.4s var(--ease-spring, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .pricing-cta:hover .cta-icon-wrap {
    transform: translateX(2px) scale(1.05);
    background: rgba(255, 255, 255, 0.1);
  }

  .pricing-cta--featured {
    background: var(--color-copper);
    color: white;
    border-color: var(--color-copper);
  }

  .pricing-cta--featured:hover {
    background: var(--color-copper-light);
    border-color: var(--color-copper-light);
    color: white;
  }

  .pricing-cta--featured .cta-icon-wrap {
    background: rgba(0, 0, 0, 0.2);
  }

  .pricing-note {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
  }

  .pricing-note svg { color: var(--color-forge-muted); flex-shrink: 0; margin-top: 0.15em; }

  .pricing-note p {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-forge-muted);
    line-height: 1.6;
  }

  .pricing-note a {
    color: var(--color-copper);
    text-decoration: none;
    font-weight: 600;
  }

  .pricing-note a:hover { text-decoration: underline; }

  @media (max-width: 1024px) {
    .pricing-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .pricing-grid { grid-template-columns: 1fr; gap: 0.75rem; }
    .pricing-card { padding: 1.75rem 1.25rem; }
  }
</style>
