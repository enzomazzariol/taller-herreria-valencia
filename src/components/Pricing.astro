---
import content from '../data/content.json';
const services = content.services;
const wa = content.contact.whatsapp;
const featuredId = 'portones';
---

<section id="precios" class="pricing-section">
  <div class="container">
    <div class="section-eyebrow" data-reveal>
      <span class="eyebrow-tag">03 — Precios</span>
      <div class="eyebrow-rule"></div>
    </div>

    <p class="section-note" data-reveal>
      Todos los precios incluyen materiales, pintura anticorrosiva e instalación. Lo que ves es lo que pagas.
    </p>

    <div class="grid" data-reveal>
      {services.map((s) => {
        const featured = s.id === featuredId;
        return (
          <div class:list={['card', featured && 'card--featured']}>
            {featured && <span class="badge">Más popular</span>}
            <span class="card-eyebrow">{s.short}</span>
            <h3 class="card-title">{s.name}</h3>
            <div class="card-price">
              {s.pricing[0].price ? `Desde $${s.pricing[0].price.toLocaleString()}` : 'A consultar'}
            </div>
            <ul class="card-features">
              {s.features.slice(0, 4).map(f => <li>{f}</li>)}
            </ul>
            <a
              href={`https://wa.me/${wa}?text=${encodeURIComponent('Hola, quiero un presupuesto para ' + s.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class:list={['cta-btn', featured && 'cta-btn--filled']}
            >
              Solicitar presupuesto
            </a>
          </div>
        );
      })}
    </div>

    <p class="closing-note" data-reveal>
      ¿Proyecto grande o fuera de lista?
      <a href={`https://wa.me/${wa}?text=${encodeURIComponent('Hola, tengo un proyecto especial que me gustaría presupuestar')}`} target="_blank" rel="noopener noreferrer">
        Conversamos y te damos un presupuesto personalizado →
      </a>
    </p>
  </div>
</section>

<style>
  .pricing-section {
    padding: 0 clamp(1.5rem, 4vw, 3rem) var(--section-py);
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
  }

  .section-eyebrow {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow-tag {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-copper);
    white-space: nowrap;
  }

  .eyebrow-rule {
    flex: 1;
    height: 1px;
    background: var(--color-forge-border);
  }

  .section-note {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-forge-muted);
    max-width: 560px;
    margin-bottom: 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .card {
    position: relative;
    background: var(--color-forge-iron);
    border: 1px solid var(--color-forge-border);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.4s var(--ease-spring), transform 0.4s var(--ease-spring), background 0.4s var(--ease-spring);
  }

  .card:hover {
    border-color: rgba(217, 123, 63, 0.5);
    transform: translateY(-6px);
    background: color-mix(in srgb, var(--color-forge-iron) 90%, var(--color-copper));
  }

  .card--featured {
    border-color: var(--color-copper);
  }

  .card--featured:hover {
    transform: translateY(-8px);
  }

  .card-price {
    transition: transform 0.4s var(--ease-spring);
  }

  .card:hover .card-price {
    transform: translateX(3px);
  }

  .badge {
    position: absolute;
    top: -1px;
    right: -1px;
    background: var(--color-copper);
    color: var(--color-forge-black);
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.375rem 0.75rem;
  }

  .card-eyebrow {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-forge-muted);
    margin-bottom: 1rem;
  }

  .card--featured .card-eyebrow { color: var(--color-copper); }

  .card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
    color: var(--color-forge-smoke);
    margin-bottom: 0.625rem;
  }

  .card-price {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.5rem;
    color: var(--color-copper);
    margin-bottom: 1.625rem;
  }

  .card-features {
    list-style: none;
    padding: 1.25rem 0;
    margin: 0 0 1.5rem;
    border-top: 1px solid var(--color-forge-border);
    font-family: var(--font-body);
    font-size: 0.84rem;
    color: var(--color-forge-muted);
    line-height: 2;
  }

  .cta-btn {
    margin-top: auto;
    display: block;
    text-align: center;
    border: 1px solid var(--color-forge-smoke);
    color: var(--color-forge-smoke);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.875rem;
    transition: background 0.3s var(--ease-spring), color 0.3s var(--ease-spring), transform 0.3s var(--ease-spring);
  }

  .cta-btn:hover { background: var(--color-forge-smoke); color: var(--color-forge-black); transform: translateY(-2px); }
  .cta-btn:active { transform: translateY(0) scale(0.97); }

  .cta-btn--filled {
    background: var(--color-copper);
    border-color: var(--color-copper);
    color: var(--color-forge-black);
  }

  .cta-btn--filled:hover { background: var(--color-copper-light); color: var(--color-forge-black); }

  .closing-note {
    text-align: center;
    margin-top: 2.25rem;
    font-family: var(--font-body);
    font-size: 0.84rem;
    color: var(--color-forge-muted);
  }

  .closing-note a {
    color: var(--color-copper);
    text-decoration: none;
    border-bottom: 1px solid var(--color-copper);
  }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
