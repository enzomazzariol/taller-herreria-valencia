---
import content from '../data/content.json';
const c = content.contact;

const d = 0.012;
const bbox = [c.lon - d, c.lat - d, c.lon + d, c.lat + d].join('%2C');
const mapEmbedUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&marker=${c.lat}%2C${c.lon}&layer=mapnik`;
const mapLinkUrl = `https://www.openstreetmap.org/?mlat=${c.lat}&mlon=${c.lon}#map=16/${c.lat}/${c.lon}`;
---

<section id="contacto" class="contact-section">
  <div class="container">
    <div class="section-eyebrow" data-reveal>
      <span class="eyebrow-tag">07 — Contacto</span>
      <div class="eyebrow-rule"></div>
    </div>

    <div class="grid" data-reveal>
      <div class="form-col">
        <h2>Cuéntanos qué necesitas forjar</h2>
        <form id="contactForm" class="form">
          <label class="field">
            <span>Nombre</span>
            <input type="text" name="nombre" required />
          </label>
          <label class="field">
            <span>Teléfono</span>
            <input type="tel" name="telefono" required />
          </label>
          <label class="field">
            <span>Cuéntanos tu proyecto</span>
            <textarea name="mensaje" rows="3"></textarea>
          </label>
          <button type="submit" class="submit-btn">Enviar mensaje</button>
        </form>
      </div>

      <a href={mapLinkUrl} target="_blank" rel="noopener noreferrer" class="map-card" aria-label="Abrir ubicación en el mapa">
        <iframe
          class="map-iframe"
          src={mapEmbedUrl}
          loading="lazy"
          title="Ubicación de Flamingo Services — Valencia, Carabobo"
        ></iframe>
        <div class="map-scrim" aria-hidden="true"></div>
        <span class="map-label">MAPA — REF. 07</span>
        <div class="map-info">
          <span class="map-city">Valencia, Carabobo</span>
          <span>Tel. {c.phone}</span>
          <span>{c.hours}</span>
        </div>
      </a>
    </div>
  </div>
</section>

<script define:vars={{ wa: c.whatsapp }}>
  document.getElementById('contactForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(e.target);
    const nombre = data.get('nombre');
    const telefono = data.get('telefono');
    const mensaje = data.get('mensaje') || '(sin detalles adicionales)';
    const msg = `Hola, soy ${nombre} (tel. ${telefono}).\n\n${mensaje}`;
    window.open(`https://wa.me/${wa}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
  });
</script>

<style>
  .contact-section {
    padding: 0 clamp(1.5rem, 4vw, 3rem) var(--section-py);
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
  }

  .section-eyebrow {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .eyebrow-tag {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-copper);
    white-space: nowrap;
  }

  .eyebrow-rule {
    flex: 1;
    height: 1px;
    background: var(--color-forge-border);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
  }

  .form-col h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    line-height: 1.2;
    color: var(--color-forge-smoke);
    margin-bottom: 1.5rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    max-width: 440px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field span {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-forge-muted);
  }

  .field input,
  .field textarea {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-forge-border);
    padding-bottom: 0.75rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-forge-smoke);
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--color-copper);
  }

  .submit-btn {
    margin-top: 0.75rem;
    align-self: flex-start;
    background: var(--color-copper);
    color: var(--color-forge-black);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    padding: 1rem 1.75rem;
    transition: background 0.3s var(--ease-spring), transform 0.3s var(--ease-spring);
  }

  .submit-btn:hover { background: var(--color-copper-light); transform: translateY(-2px); }
  .submit-btn:active { transform: translateY(0) scale(0.97); }

  .map-card {
    position: relative;
    display: block;
    height: 420px;
    background: var(--color-forge-iron);
    border: 1px solid var(--color-forge-border);
    overflow: hidden;
    transition: border-color 0.4s var(--ease-spring);
  }

  .map-card:hover {
    border-color: rgba(217, 123, 63, 0.4);
  }

  .map-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.5) invert(0.92) contrast(0.9) brightness(0.95);
    transition: filter 0.4s var(--ease-spring), transform 0.6s var(--ease-spring);
    pointer-events: none;
  }

  .map-card:hover .map-iframe {
    filter: grayscale(0.25) invert(0.92) contrast(0.95) brightness(1);
    transform: scale(1.03);
  }

  .map-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20,20,20,0.55) 0%, transparent 30%, transparent 70%, rgba(20,20,20,0.75) 100%);
    pointer-events: none;
  }

  .map-label {
    position: absolute;
    left: 20px;
    top: 20px;
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--color-forge-smoke);
  }

  .map-info {
    position: absolute;
    right: 20px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    color: var(--color-forge-muted);
    text-align: right;
  }

  .map-city {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-forge-smoke);
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
