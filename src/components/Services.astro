---
import content from '../data/content.json';
const [featured, ...rest] = content.services;
const wa = content.contact.whatsapp;

const seeds: Record<string, string> = {
  techos: 'flamingo-techo',
  pergolas: 'svc-pergola',
  portones: 'svc-porton',
  puertas: 'svc-puerta',
};
---

<section id="servicios" class="services-section">
  <div class="container">
    <a
      href={`https://wa.me/${wa}?text=${encodeURIComponent('Hola, me interesa un presupuesto para ' + featured.name)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="featured-card"
      data-reveal
    >
      <img
        src={`https://picsum.photos/seed/${seeds[featured.id]}/1000/1200`}
        alt=""
        loading="lazy"
        onerror="this.remove()"
      />
      <div class="featured-scrim"></div>
      <div class="featured-body">
        <span class="card-num">01</span>
        <h3 class="featured-title">{featured.name}</h3>
        <p class="featured-desc">{featured.description}</p>
        <div class="featured-foot">
          <span class="price">{featured.pricing[0].prefix} ${featured.pricing[0].price?.toLocaleString()}</span>
          <span class="cta-btn">Pedir presupuesto</span>
        </div>
      </div>
    </a>

    <div class="grid" data-reveal>
      {rest.map((s, i) => (
        <div class="card">
          <div class="thumb">
            <img
              src={`https://picsum.photos/seed/${seeds[s.id]}/500/300`}
              alt=""
              loading="lazy"
              onerror="this.remove()"
            />
          </div>
          <div class="card-body">
            <span class="card-num">0{i + 2}</span>
            <h3 class="card-title">{s.name}</h3>
            <p class="card-desc">{s.description}</p>
            <ul class="card-features">
              {s.features.slice(0, 4).map(f => <li>✓ {f}</li>)}
            </ul>
            <div class="card-foot">
              <span class="price">{s.pricing[0].prefix} ${s.pricing[0].price?.toLocaleString()}</span>
              <a
                href={`https://wa.me/${wa}?text=${encodeURIComponent('Hola, me interesa un presupuesto para ' + s.name)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="cta-btn"
              >
                Pedir presupuesto
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: var(--section-py) clamp(1.5rem, 4vw, 3rem);
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
  }

  .featured-card {
    position: relative;
    display: block;
    height: 480px;
    overflow: hidden;
    text-decoration: none;
    background: var(--color-forge-iron);
    border: 1px solid transparent;
    transition: border-color 0.4s var(--ease-spring);
  }

  .featured-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.6) contrast(1.1);
    transform: scale(1.04);
    transition: transform 0.7s var(--ease-spring), filter 0.7s var(--ease-spring);
  }

  .featured-card:hover img {
    transform: scale(1.1);
    filter: saturate(0.75) contrast(1.1);
  }

  .featured-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(20,20,20,0.94) 0%, transparent 50%);
  }

  .featured-body {
    position: absolute;
    left: 2rem;
    right: 2rem;
    bottom: 2rem;
  }

  .card-num {
    display: block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-bronze);
    margin-bottom: 0.625rem;
  }

  .featured-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-forge-smoke);
    margin-bottom: 0.75rem;
  }

  .featured-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-forge-muted);
    max-width: 440px;
    margin-bottom: 1.125rem;
  }

  .featured-foot, .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .price {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.375rem;
    color: var(--color-copper);
  }

  .cta-btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-forge-smoke);
    border: 1px solid var(--color-forge-smoke);
    text-decoration: none;
    padding: 0.7rem 1.125rem;
    white-space: nowrap;
    transition: background 0.3s var(--ease-spring), color 0.3s var(--ease-spring);
  }

  .cta-btn:hover { background: var(--color-forge-smoke); color: var(--color-forge-black); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .card {
    background: var(--color-forge-iron);
    border: 1px solid var(--color-forge-border);
    display: flex;
    flex-direction: column;
    transition: transform 0.4s var(--ease-spring);
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .thumb {
    height: 170px;
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.6);
    transform: scale(1.05);
    transition: transform 0.6s var(--ease-spring);
  }

  .card:hover .thumb img {
    transform: scale(1.12);
  }

  .card-body {
    padding: 1.625rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
    color: var(--color-forge-smoke);
    margin: 0.5rem 0 0.625rem;
  }

  .card-desc {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-forge-muted);
    margin-bottom: 0.875rem;
  }

  .card-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-forge-muted);
    line-height: 2;
  }

  .card-features li::marker { content: ''; }

  .card-foot {
    margin-top: auto;
  }

  .card-foot .price { font-size: 1.5rem; }
  .card-foot .cta-btn { padding: 0.625rem 0.875rem; font-size: 0.72rem; }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .featured-card { height: 380px; }
    .grid { grid-template-columns: 1fr; }
    .featured-foot, .card-foot { flex-direction: column; align-items: flex-start; }
  }
</style>
