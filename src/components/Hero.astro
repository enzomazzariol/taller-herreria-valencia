---
import content from '../data/content.json';
const b = content.business;
---

<section id="inicio" class="hero">
  <div class="hero-bg" aria-hidden="true">
    <img
      src="https://picsum.photos/seed/yunque-taller-2/1800/1200"
      alt=""
      class="hero-photo"
      onerror="this.closest('.hero-bg').classList.add('no-photo'); this.remove()"
    />
    <div class="bg-grid"></div>
    <div class="bg-wash"></div>
    <div class="bg-gradient"></div>
    <div class="bg-scrim-corner"></div>
    <div class="bg-scrim-top"></div>
  </div>

  <div class="hero-content">
    <div class="kicker" data-reveal data-reveal-delay="100">
      <span class="kicker-line" aria-hidden="true"></span>
      Taller de herrería en Valencia, Carabobo
    </div>

    <h1 class="hero-title" data-reveal data-reveal-delay="200">
      LA MEJOR<br />
      HERRERÍA DE<br />
      <span class="accent">VALENCIA, CARABOBO</span>
    </h1>

    <div class="hero-row" data-reveal data-reveal-delay="300">
      <p class="hero-sub">
        Fabricamos e instalamos portones, rejas, barandillas, escaleras metálicas y estructuras de acero a medida.
        Más de {b.experience_years} años forjando confianza en Valencia, Carabobo. Presupuesto claro y acabados que resisten el tiempo.
      </p>
      <a href="#servicios" class="hero-cta">Ver catálogo →</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: clamp(6.5rem, 12vw, 8rem) clamp(1.5rem, 4vw, 3rem) clamp(3.5rem, 8vw, 5rem);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.55) contrast(1.12) brightness(0.75);
    animation: hero-kenburns 18s ease-out forwards;
  }

  @keyframes hero-kenburns {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo { animation: none; }
  }

  .hero-bg.no-photo {
    background:
      radial-gradient(ellipse 70% 50% at 30% 20%, var(--color-copper-wash) 0%, transparent 60%),
      repeating-linear-gradient(135deg, rgba(255,255,255,0.02) 0 2px, transparent 2px 14px),
      var(--color-forge-black);
  }

  .bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 40%, black 20%, transparent 100%);
  }

  .bg-wash {
    position: absolute;
    inset: 0;
    background: var(--color-copper-wash);
    mix-blend-mode: multiply;
  }

  .bg-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20,20,20,0) 20%, rgba(20,20,20,0.94) 96%);
  }

  .bg-scrim-corner {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 65%;
    height: 60%;
    background: radial-gradient(ellipse at bottom left, rgba(20,20,20,0.9) 0%, rgba(20,20,20,0.5) 45%, transparent 75%);
  }

  .bg-scrim-top {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 130px;
    background: linear-gradient(180deg, rgba(20,20,20,0.9) 0%, transparent 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    margin-top: auto;
    max-width: 1100px;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-forge-smoke);
    margin-bottom: 1.25rem;
  }

  .kicker-line {
    width: 44px;
    height: 2px;
    background: var(--color-copper);
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.6rem, 6.4vw, 5rem);
    line-height: 1.06;
    letter-spacing: -0.01em;
    color: var(--color-forge-smoke);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .hero-title .accent { color: var(--color-copper); }

  .hero-row {
    margin-top: 1.25rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-forge-muted);
    max-width: 460px;
  }

  .hero-cta {
    flex-shrink: 0;
    background: var(--color-copper);
    color: var(--color-forge-black);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    padding: 1rem 1.75rem;
    white-space: nowrap;
    transition: background 0.3s var(--ease-spring), transform 0.3s var(--ease-spring), letter-spacing 0.3s var(--ease-spring);
    display: inline-block;
  }

  .hero-cta:hover {
    background: var(--color-copper-light);
    transform: translateX(3px);
    letter-spacing: 0.01em;
  }

  .hero-cta:active { transform: translateX(3px) scale(0.97); }

  @media (max-width: 640px) {
    .hero-row { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .hero-cta { width: 100%; text-align: center; }
  }
</style>
