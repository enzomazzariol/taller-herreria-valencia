---
import { resenas } from "../data/site";
---

<section class="resenas-sec">
  <div class="resenas">
    {resenas.map(r => (
      <blockquote data-reveal class="resena">
        <span class="stars" role="img" aria-label="Calificación: 5 de 5 estrellas">
          {Array.from({ length: 5 }).map(() => (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17.6l-6.1 3.4 1.5-6.8-5.2-4.7 6.9-.7z"/></svg>
          ))}
        </span>
        <span class="quote">&ldquo;</span>
        <p>{r.q}</p>
        <footer>{r.a}</footer>
      </blockquote>
    ))}
  </div>
</section>

<style>
  .resenas-sec { padding:0 clamp(16px,3vw,48px) clamp(72px,8vw,120px); }
  .resenas { max-width:1240px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr)); gap:clamp(18px,2vw,26px); }
  .resena { min-width:0; margin:0; padding:clamp(30px,2.8vw,40px) clamp(26px,2.4vw,34px); border-radius:var(--fl-r); background:var(--fl-panel); border:1px solid var(--fl-line); display:flex; flex-direction:column; gap:22px; transition:transform .6s cubic-bezier(.2,.8,.2,1); }
  .resena:hover { transform:translateY(-6px); }
  .resena .stars { display:flex; gap:3px; color:var(--fl-accent); }
  .resena .quote { font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:34px; font-weight:700; line-height:1; color:var(--fl-accent); margin:-4px 0 -26px; }
  .resena p { margin:0; font-family:'Bricolage Grotesque',Archivo,sans-serif; font-size:23px; font-weight:600; letter-spacing:-.025em; line-height:1.35; color:var(--fl-ink); }
  .resena footer { margin-top:auto; font-size:11px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; color:var(--fl-muted); }
</style>
